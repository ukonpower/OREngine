{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "es2021"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": true,
    "typeRoots": [
      "node_modules",
      "node_modules/@types",
      "./node_modules/@figma"
    ],
    "types": [
      "@webgpu/types",
      "node",
      "dom-mediacapture-transform",
      "dom-webcodecs"
    ],
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "glpower": [
        "./packages/glpower/packages/glpower/src"
      ],
      "maxpower": [
        "./packages/maxpower"
      ],
      "orengine": [
        "./packages/orengine/index.ts"
      ],
      "orengine/*": [
        "./packages/orengine/*"
      ],
      "@or-backend": [
        "./packages/maxpower/Backend/GLBackend/index.ts"
      ],
      "@or-scene": [
        "./demo/scene.json"
      ],
      "@or-editor": [
        "./demo/editor.json"
      ],
      "@or-resources/*": [
        "./demo/Resources/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/glpower",
    "demo",
    "scripts",
    "host/vite",
    "host/runner.ts",
    "host/index.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
