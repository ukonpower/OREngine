{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": true,
    "lib": [
      "es2021"
    ]
  },
  "include": [
    "./plugins",
    "./vite-plugins",
    "./vite-configs"
  ]
}