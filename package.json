{
  "name": "orengine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./packages/orengine/index.ts",
    "./react": "./packages/orengine/react.tsx",
    "./editor": "./packages/orengine/editor/lib/index.ts",
    "./core": "./packages/orengine/core/index.ts",
    "./server": "./host/server/factory.ts",
    "./host": "./host/index.ts",
    "./configs": "./host/vite/configs.ts",
    "./maxpower": "./packages/maxpower/webgl/index.ts",
    "./glpower": "./packages/glpower/index.ts",
    "./mathpower": "./packages/mathpower/index.ts",
    "./basepower": "./packages/basepower/index.ts",
    "./player": "./packages/orengine/player/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "predev": "node -e \"try{require('child_process').execSync('lsof -ti:'+(process.env.ORENGINE_SERVER_PORT||3001)+' | xargs kill -9',{stdio:'ignore'})}catch(e){}\"",
    "dev": "tsx scripts/run.ts dev",
    "wgpu": "ORENGINE_RENDERER=webgpu ORENGINE_PROJECT=${ORENGINE_PROJECT:-demo-webgpu} npm run dev",
    "build": "tsx scripts/run.ts build",
    "build:static": "tsx scripts/run.ts build:static",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "vrt": "npm run build-storybook && playwright test -c tests/vrt/playwright.config.ts",
    "vrt:update": "npm run build-storybook && playwright test -c tests/vrt/playwright.config.ts --update-snapshots",
    "lint": "eslint \"**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit && find packages -name '*.scss' | xargs -I{} sass --load-path=packages/orengine/editor --no-source-map --quiet {} /dev/null"
  },
  "dependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "express": "^4.21.0",
    "mediabunny": "^1.38.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.62.1",
    "@rollup/pluginutils": "^5.1.3",
    "@storybook/react-vite": "^10.5.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.71",
    "body-parser": "^1.20.3",
    "eslint": "^9.14.0",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.12.0",
    "node-zopfli": "^2.1.4",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass-embedded": "^1.80.6",
    "storybook": "^10.5.7",
    "terser": "^5.36.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.10"
  },
  "volta": {
    "node": "23.3.0"
  }
}
