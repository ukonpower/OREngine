{
  "name": "orengine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./packages/orengine/index.ts",
    "./react": "./packages/orengine/react.tsx",
    "./editor": "./packages/orengine/editor/lib/index.ts",
    "./core": "./packages/orengine/core/index.ts",
    "./server": "./host/server/factory.ts",
    "./host": "./host/index.ts",
    "./configs": "./host/vite/configs.ts",
    "./maxpower": "./packages/maxpower/webgl/index.ts",
    "./glpower": "./packages/glpower/index.ts",
    "./mathpower": "./packages/mathpower/index.ts",
    "./basepower": "./packages/basepower/index.ts",
    "./player": "./packages/orengine/player/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "predev": "node -e \"try{require('child_process').execSync('lsof -ti:'+(process.env.ORENGINE_SERVER_PORT||3001)+' | xargs kill -9',{stdio:'ignore'})}catch(e){}\"",
    "dev": "tsx scripts/run.ts dev",
    "wgpu": "ORENGINE_RENDERER=webgpu ORENGINE_PROJECT=${ORENGINE_PROJECT:-demo-webgpu} npm run dev",
    "player:build": "tsx scripts/run.ts player:build",
    "editor:build": "tsx scripts/run.ts editor:build",
    "shader-minifier:setup": "bash scripts/setup-shader-minifier.sh",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "vrt": "npm run storybook:build && playwright test -c tests/vrt/playwright.config.ts",
    "vrt:update": "npm run storybook:build && playwright test -c tests/vrt/playwright.config.ts --update-snapshots",
    "lint": "eslint \"**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit && find packages -name '*.scss' | xargs -I{} sass --load-path=packages/orengine/editor --no-source-map --quiet {} /dev/null"
  },
  "dependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "express": "^5.2.1",
    "mediabunny": "^1.38.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.62.1",
    "@rollup/pluginutils": "^5.1.3",
    "@storybook/react-vite": "^10.5.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.71",
    "eslint": "^9.14.0",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^17.11.0",
    "node-zopfli": "^2.1.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.80.6",
    "storybook": "^10.5.7",
    "terser": "^5.36.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.10"
  },
  "volta": {
    "node": "24.12.0"
  }
}
