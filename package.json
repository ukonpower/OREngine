{
  "name": "orengine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./packages/orengine/index.tsx",
    "./react": "./packages/orengine/react.tsx",
    "./core": "./packages/orengine/core/index.ts",
    "./server": "./server/factory.ts",
    "./host": "./host/index.ts",
    "./configs": "./vite-configs.ts",
    "./maxpower": "./packages/maxpower/index.ts",
    "./glpower": "./packages/glpower/packages/glpower/src/index.ts",
    "./BuiltinResources/*": "./packages/orengine/BuiltinResources/*",
    "./player": "./packages/orengine/ts/Player/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "init": "git submodule init && git submodule update && npm install",
    "predev": "node -e \"try{require('child_process').execSync('lsof -ti:'+(process.env.ORENGINE_SERVER_PORT||3001)+' | xargs kill -9',{stdio:'ignore'})}catch(e){}\"",
    "dev": "tsx scripts/run.mjs dev",
    "build": "tsx scripts/run.mjs build",
    "build:static": "tsx scripts/run.mjs build:static",
    "lint": "eslint \"**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit && find packages -name '*.scss' | xargs -I{} sass --no-source-map --quiet {} /dev/null",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@spz-loader/core": "^0.2.0",
    "chokidar": "^3.6.0",
    "express": "^4.21.0",
    "mediabunny": "^1.38.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "webgl-memory": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@rollup/pluginutils": "^5.1.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "body-parser": "^1.20.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.12.0",
    "install": "^0.13.0",
    "node-zopfli": "^2.1.4",
    "pnpm": "^9.12.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass-embedded": "^1.80.6",
    "terser": "^5.36.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.0.18",
    "ws": "^8.19.0"
  },
  "volta": {
    "node": "23.3.0"
  }
}
